# Leave empty to use the local development server on port 8787.
# For a shared platform, build every client with the same HTTPS backend.
VITE_TUGA_API_URL=
# Public HTTPS URL of the released Windows installer.
VITE_TUGA_WINDOWS_DOWNLOAD_URL=
# Public website URL for the desktop "Open in browser" action.
VITE_TUGA_WEB_URL=
# Server-side: comma-separated frontend origins allowed to connect.
TUGA_ALLOWED_ORIGINS=
