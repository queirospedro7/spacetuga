# Tuga TURN deployment variables
# Set these in the environment of the Tuga signaling/API server.
TUGA_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TUGA_TURN_SECRET=replace-with-the-same-long-random-secret-as-coturn
TUGA_STUN_URLS=stun:turn.example.com:3478
# Generate a separate random secret for JWT signing in production.
TUGA_JWT_SECRET=replace-with-a-separate-long-random-secret
