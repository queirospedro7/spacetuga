{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuga",
  "version": "0.2.3",
  "identifier": "com.melo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [{
      "title": "Tuga",
      "width": 1280,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "backgroundColor": "#111111"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:8787 ws://localhost:8787 http://127.0.0.1:* ws://127.0.0.1:* ws: wss: https:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Conversas e chamadas privadas",
    "longDescription": "Tuga para conversas, comunidades e chamadas.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../backend/index.mjs": "backend/index.mjs",
      "../server/index.mjs": "server/index.mjs",
      "../node_modules/ws": "node_modules/ws",
      "binaries/node.exe": "binaries/node.exe"
    }
  }
}
